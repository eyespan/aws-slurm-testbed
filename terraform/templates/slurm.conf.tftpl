# slurm.conf - Slurm scheduler configuration for HPC Platform Operations Test Bed
# Generated by Terraform
#
# This configuration includes:
# - Slurm controller (slurmctld) on the controller node
# - Slurmdbd for accounting
# - Two partitions: debug (static, t3.micro) and std (cloud, power-saved)

SlurmctldHost=${controller_hostname} (${controller_ip})

# Authentication
AuthType=auth/munge
AuthOptions=none

# SLURM accounting
AccountingStorageType=accounting_storage/slurmdbd
AccountingStorageHost=${accounting_host}
AccountingStoragePort=6819
AccountingStorageUser=slurm
AccountingStorageEnforce=associations

# Account storage
AccountingStoragePass=${mariadb_password}

# Cluster name
ClusterName=${project}-${env}-${session}

# Slurm version
SlurmctldPidFile=/var/run/slurmctld.pid
SlurmctldPort=6817

# Daemon pid file
SlurmdPidFile=/var/run/slurmd.pid
SlurmdPort=6818

# Slurm user
SlurmUser=slurm
SlurmdUser=root

# Spool directory
StateSaveLocation=${state_dir}
SlurmdSpoolDir=/var/spool/slurmd

# Slurm configuration directory
SlurmConfigDir=/etc/slurm

# Logging
SlurmctldDebug=info
SlurmdDebug=info

# Slurmctld parameters
SlurmctldTimeout=30
SlurmdTimeout=30
WaitTime=0

# Scheduler parameters
SchedulerType=sched/backfill
SelectType=select/cons_res
SelectTypeParameters=CR_CPU_Memory

# Preemption parameters
PreemptType=preempt/partition_prio
PreemptMode=REQUEUE

# Return to service parameters
ReturnToService=0

# suspend parameters
SuspendTime=300
SuspendTimeout=120
ResumeTimeout=300
ResumeRate=0
SuspendProgram=/opt/hpc/slurm_suspend.py
ResumeProgram=/opt/hpc/slurm_resume.py

# node state parameters
StateSavePath=${state_dir}
SrunPortRange=10000-20000

# Gres types
GresTypes=gpu

# Energy management
PlugincacheInterval=60
PluginDir=/usr/lib64/slurm:/usr/lib/slurm

# Task plugin
TaskPlugin=task/none

# Frontend nodes
FrontEndName=${controller_hostname}
FrontEndPort=6817

# Compute nodes will be added dynamically by the scheduler
