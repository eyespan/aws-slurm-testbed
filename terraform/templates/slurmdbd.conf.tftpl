# slurmdbd.conf - Slurm Database daemon configuration
# Generated by Terraform
#
# This configuration enables Slurm accounting with MariaDB backend

# Authentication
AuthType=auth/munge
AuthOptions=none

# Slurmctld connection
SlurmctldPidFile=/var/run/slurmctld.pid
SlurmctldHost=${controller_hostname}

# Database connection
ArchType=MySQL
StorageHost=${mariadb_host}
StoragePort=3306
StorageUser=${mariadb_username}
StoragePass=${mariadb_password}
StorageLoc=${mariadb_db_name}

# Slurm user
StorageUser=slurm

# Logging
LogLevel=info
LogFile=/var/log/slurm/slurmdbd.log

# Authentication parameters
AuthInfo=/var/run/munge/munge.socket.2

# Default retention policies
ArchiveEventsSecs=0
ArchiveJobsSecs=0
ArchiveStepSecs=0
ArchiveResvsSecs=0
ArchiveSassocSecs=0

# accounting storage parameters
AccountingStorageType=accounting_storage/mysql
AccountingStorageHost=${mariadb_host}
AccountingStoragePort=3306
AccountingStorageUser=${mariadb_username}
AccountingStoragePass=${mariadb_password}
AccountingStorageLoc=${mariadb_db_name}

# Slurm accounting
SlurmAccountingStorageType=accounting_storage/slurmdbd
SlurmAccountingStorageHost=${controller_hostname}
SlurmAccountingStoragePort=6819
