# cgroup.conf - cgroup configuration for Slurm
# Generated by Terraform

# Systemd cgroup configuration
CgroupMountpoint=/sys/fs/cgroup

# Systemd cgroup automation
CgroupAutomount=yes

# Systemd cgroup release agent
CgroupReleaseAgentDir=/etc/slurm/cgroup

# Allowed cgroup controllers
AllowedFeatures=cpuset

# Cgroup monitoring
CgroupPlugin=task/cgroup

# Cgroup monitoring interval
CgroupAutomountInterval=10

# Cgroup monitoring timeout
CgroupAutomountTimeout=30

# Cgroup monitoring retry count
CgroupAutomountRetryCount=3

# Cgroup monitoring retry delay
CgroupAutomountRetryDelay=5
